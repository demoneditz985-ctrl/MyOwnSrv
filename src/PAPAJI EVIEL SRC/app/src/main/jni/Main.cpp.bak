// ============================================================
//  POKEBALL TAB BUTTON
// ============================================================
static bool PokeballTab(const char* label, bool active)
{
    ImGuiWindow* window = ImGui::GetCurrentWindow();
    if (window->SkipItems) return false;

    const ImGuiID id = window->GetID(label);
    const ImVec2 label_size = ImGui::CalcTextSize(label, NULL, true);

    float radius = 22.0f;
    ImVec2 pos = window->DC.CursorPos;
    ImVec2 size(radius * 2.0f + 6.0f, radius * 2.0f + 6.0f);
    ImRect bb(pos, ImVec2(pos.x + size.x, pos.y + size.y));

    ImGui::ItemSize(bb, 0.0f);
    if (!ImGui::ItemAdd(bb, id)) return false;

    bool hovered, held;
    bool pressed = ImGui::ButtonBehavior(bb, id, &hovered, &held);

    ImDrawList* dl = window->DrawList;
    ImVec2 center(pos.x + size.x * 0.5f, pos.y + size.y * 0.5f);

    ImU32 col_top    = active ? IM_COL32(255, 215, 0, 255)
                              : (hovered ? IM_COL32(255, 235, 120, 255)
                                         : IM_COL32(255, 215, 0, 220));
    ImU32 col_bottom = active ? IM_COL32(255, 0, 0, 255) : IM_COL32(220, 220, 220, 255);
    ImU32 col_white  = IM_COL32(255, 255, 255, 255);
    ImU32 col_black  = IM_COL32(0, 0, 0, 255);

    // Top half (yellow)
    dl->PathArcTo(center, radius, IM_PI, IM_PI * 2.0f, 32);
    dl->PathFillConvex(col_top);
    // Bottom half (red / gray)
    dl->PathArcTo(center, radius, 0.0f, IM_PI, 32);
    dl->PathFillConvex(col_bottom);
    // Center white band
    dl->AddRectFilled(ImVec2(center.x - radius, center.y - 4.0f),
                      ImVec2(center.x + radius, center.y + 4.0f), col_white);
    // Center circle
    dl->AddCircleFilled(center, 6.0f, col_white, 24);
    dl->AddCircle(center, 6.0f, col_black, 24, 2.0f);
    // Outline
    dl->AddCircle(center, radius, col_black, 32, 2.5f);

    // Label below
    ImVec2 txt_pos(center.x - label_size.x * 0.5f, bb.Max.y + 2.0f);
    dl->AddText(txt_pos, IM_COL32(60, 40, 0, 255), label);

    return pressed;
}

// ============================================================
//  PIKACHU TOGGLE
// ============================================================
void PikachuToggle(const char* label, bool* v)
{
    ImGuiWindow* window = ImGui::GetCurrentWindow();
    if (window->SkipItems) return;

    const ImGuiID id = window->GetID(label);
    const ImVec2 label_size = ImGui::CalcTextSize(label, NULL, true);

    float h = 24.0f;
    float w = 48.0f;
    float radius = h * 0.5f;

    ImVec2 pos = window->DC.CursorPos;
    ImRect bb(pos, ImVec2(pos.x + w, pos.y + h));
    ImGui::ItemSize(bb, 0.0f);
    if (!ImGui::ItemAdd(bb, id)) return;

    bool hovered, held;
    bool pressed = ImGui::ButtonBehavior(bb, id, &hovered, &held);
    if (pressed) *v = !*v;

    static float anim = 0.0f;
    anim = ImLerp(anim, *v ? 1.0f : 0.0f, ImGui::GetIO().DeltaTime * 14.0f);

    ImDrawList* dl = window->DrawList;
    ImU32 bg = *v ? IM_COL32(255, 215, 0, 255) : IM_COL32(204, 204, 204, 255);
    dl->AddRectFilled(bb.Min, bb.Max, bg, radius);
    dl->AddRect(bb.Min, bb.Max, IM_COL32(255, 215, 0, 255), radius, 0, 2.5f);

    // Knob — white circle with red cheek
    float knob_x = bb.Min.x + radius + (w - h) * anim;
    ImVec2 knob_center(knob_x, bb.Min.y + radius);
    dl->AddCircleFilled(knob_center, radius - 3.0f, IM_COL32(255, 255, 255, 255), 24);
    dl->AddCircle(knob_center, radius - 3.0f, IM_COL32(0, 0, 0, 60), 24, 1.5f);
    // Red cheek
    dl->AddCircleFilled(ImVec2(knob_center.x + 4.0f, knob_center.y + 2.0f),
                        3.0f, IM_COL32(255, 0, 0, 220), 16);

    // Pikachu tail wag when ON
    if (*v && anim > 0.9f) {
        float t = (float)ImGui::GetTime() * 6.0f;
        float wag = sinf(t) * 4.0f;
        ImVec2 tail_base(bb.Max.x - 4.0f, bb.Min.y - 2.0f);
        dl->AddLine(tail_base, ImVec2(tail_base.x + 6.0f + wag, tail_base.y - 8.0f),
                    IM_COL32(255, 200, 0, 255), 2.5f);
        dl->AddLine(ImVec2(tail_base.x + 6.0f + wag, tail_base.y - 8.0f),
                    ImVec2(tail_base.x + 2.0f + wag, tail_base.y - 14.0f),
                    IM_COL32(255, 200, 0, 255), 2.5f);
    }

    // Lightning bolt when ON
    if (*v) {
        ImVec2 bolt(bb.Max.x + 4.0f, bb.Min.y + 4.0f);
        dl->AddTriangleFilled(ImVec2(bolt.x, bolt.y),
                              ImVec2(bolt.x + 6.0f, bolt.y + 2.0f),
                              ImVec2(bolt.x + 2.0f, bolt.y + 8.0f),
                              IM_COL32(255, 215, 0, 255));
    }

    // Label
    ImGui::SameLine();
    ImGui::SetCursorPosY(ImGui::GetCursorPosY() + (h - label_size.y) * 0.5f);
    ImGui::TextColored(ImVec4(0.20f, 0.15f, 0.00f, 1.00f), "%s", label);
}

// ============================================================
//  MOD MENU ROW (52px, rounded, pokeball icon + toggle)
// ============================================================
static bool ModRow(const char* label, bool* v)
{
    ImGuiWindow* window = ImGui::GetCurrentWindow();
    if (window->SkipItems) return false;

    ImGuiID id = window->GetID(label);
    ImVec2 pos = window->DC.CursorPos;
    float avail = ImGui::GetContentRegionAvail().x;
    if (avail < 100.0f) avail = 300.0f;
    ImVec2 size(avail, 52.0f);
    ImRect bb(pos, ImVec2(pos.x + size.x, pos.y + size.y));
    ImGui::ItemSize(bb, 4.0f);
    if (!ImGui::ItemAdd(bb, id)) return false;

    bool hovered, held;
    bool pressed = ImGui::ButtonBehavior(bb, id, &hovered, &held);
    if (pressed) *v = !*v;

    ImDrawList* dl = window->DrawList;
    ImU32 bg = hovered ? IM_COL32(255, 245, 180, 255) : IM_COL32(255, 249, 196, 255);
    dl->AddRectFilled(bb.Min, bb.Max, bg, 26.0f);
    dl->AddRect(bb.Min, bb.Max, IM_COL32(255, 215, 0, 255), 26.0f, 0, 2.5f);

    // Pokeball icon
    ImVec2 icon_c(bb.Min.x + 30.0f, bb.Min.y + 26.0f);
    dl->PathArcTo(icon_c, 9.0f, IM_PI, IM_PI * 2.0f, 20);
    dl->PathFillConvex(IM_COL32(255, 215, 0, 255));
    dl->PathArcTo(icon_c, 9.0f, 0.0f, IM_PI, 20);
    dl->PathFillConvex(IM_COL32(255, 0, 0, 255));
    dl->AddRectFilled(ImVec2(icon_c.x - 9.0f, icon_c.y - 2.0f),
                      ImVec2(icon_c.x + 9.0f, icon_c.y + 2.0f), IM_COL32(255, 255, 255, 255));
    dl->AddCircleFilled(icon_c, 3.0f, IM_COL32(255, 255, 255, 255), 12);
    dl->AddCircle(icon_c, 3.0f, IM_COL32(0, 0, 0, 255), 12, 1.0f);
    dl->AddCircle(icon_c, 9.0f, IM_COL32(0, 0, 0, 255), 20, 1.5f);

    // Label
    dl->AddText(ImVec2(bb.Min.x + 55.0f, bb.Min.y + 18.0f),
                IM_COL32(40, 30, 0, 255), label);

    // Right-side toggle
    float sw = 48.0f, sh = 24.0f;
    ImVec2 tpos(bb.Max.x - sw - 14.0f, bb.Min.y + (52.0f - sh) * 0.5f);
    ImU32 tbg = *v ? IM_COL32(255, 215, 0, 255) : IM_COL32(204, 204, 204, 255);
    dl->AddRectFilled(tpos, ImVec2(tpos.x + sw, tpos.y + sh), tbg, sh * 0.5f);
    dl->AddRect(tpos, ImVec2(tpos.x + sw, tpos.y + sh),
                IM_COL32(255, 215, 0, 255), sh * 0.5f, 0, 1.5f);
    float knob_x = tpos.x + sh * 0.5f + (sw - sh) * (*v ? 1.0f : 0.0f);
    ImVec2 knob_c(knob_x, tpos.y + sh * 0.5f);
    dl->AddCircleFilled(knob_c, sh * 0.5f - 2.0f, IM_COL32(255, 255, 255, 255), 20);
    dl->AddCircleFilled(ImVec2(knob_c.x + 3.0f, knob_c.y + 1.0f), 2.5f,
                        IM_COL32(255, 0, 0, 230), 12);

    return pressed;
}

// ============================================================
//  FLOATING LIGHTNING BOLTS (background)
// ============================================================
static void DrawLightningBolts()
{
    ImDrawList* dl = ImGui::GetBackgroundDrawList();
    float t = (float)ImGui::GetTime();
    float W = ImGui::GetIO().DisplaySize.x;
    float H = ImGui::GetIO().DisplaySize.y;
    if (W < 10.0f || H < 10.0f) return;

    for (int i = 0; i < 6; ++i) {
        float phase = t * 0.6f + i * 1.3f;
        float x = fmodf(phase * 90.0f + i * 137.0f, W);
        float y = 40.0f + sinf(phase * 2.0f) * 60.0f + i * 120.0f;
        if (y > H) y = fmodf(y, H);
        ImVec2 p(x, y);
        dl->AddTriangleFilled(ImVec2(p.x, p.y),
                              ImVec2(p.x + 8.0f, p.y + 3.0f),
                              ImVec2(p.x + 3.0f, p.y + 12.0f),
                              IM_COL32(255, 215, 0, 120));
    }
}

// ============================================================
//  POKEBALL WATERMARK (background)
// ============================================================
static void DrawPokeballWatermark()
{
    ImDrawList* dl = ImGui::GetBackgroundDrawList();
    ImVec2 ds = ImGui::GetIO().DisplaySize;
    if (ds.x < 50.0f || ds.y < 50.0f) return;

    ImVec2 c(ds.x - 90.0f, ds.y - 90.0f);
    float r = 80.0f;

    dl->AddCircleFilled(c, r, IM_COL32(255, 255, 255, 40), 40);
    dl->PathArcTo(c, r, IM_PI, IM_PI * 2.0f, 40);
    dl->PathFillConvex(IM_COL32(255, 215, 0, 45));
    dl->PathArcTo(c, r, 0.0f, IM_PI, 40);
    dl->PathFillConvex(IM_COL32(255, 0, 0, 45));

    dl->AddRectFilled(ImVec2(c.x - r, c.y - 5.0f),
                      ImVec2(c.x + r, c.y + 5.0f), IM_COL32(255, 255, 255, 60));

    dl->AddCircleFilled(c, 12.0f, IM_COL32(255, 255, 255, 80), 24);
    dl->AddCircle(c, 12.0f, IM_COL32(0, 0, 0, 60), 24, 3.0f);
    dl->AddCircle(c, r, IM_COL32(0, 0, 0, 60), 40, 4.0f);
}

// ============================================================
//  POKEBALL RED CLOSE BUTTON
// ============================================================
static bool PokeballCloseButton(const char* label)
{
    ImGuiWindow* window = ImGui::GetCurrentWindow();
    if (window->SkipItems) return false;

    ImGuiID id = window->GetID(label);
    ImVec2 pos = window->DC.CursorPos;
    ImVec2 size(140.0f, 44.0f);
    ImRect bb(pos, ImVec2(pos.x + size.x, pos.y + size.y));
    ImGui::ItemSize(bb, 4.0f);
    if (!ImGui::ItemAdd(bb, id)) return false;

    bool hovered, held;
    bool pressed = ImGui::ButtonBehavior(bb, id, &hovered, &held);
    ImDrawList* dl = window->DrawList;

    ImU32 bg = hovered ? IM_COL32(200, 0, 0, 255) : IM_COL32(255, 0, 0, 255);
    dl->AddRectFilled(bb.Min, bb.Max, bg, 22.0f);
    dl->AddRect(bb.Min, bb.Max, IM_COL32(255, 255, 255, 255), 22.0f, 0, 3.0f);

    ImVec2 ts = ImGui::CalcTextSize(label);
    dl->AddText(ImVec2(bb.Min.x + (size.x - ts.x) * 0.5f,
                       bb.Min.y + (size.y - ts.y) * 0.5f),
                IM_COL32(255, 255, 255, 255), label);
    return pressed;
}

// ============================================================
//  LEGACY TOGGLE (kept, used for Speed Timer)
// ============================================================
void Zxcmukku(const char* label, bool* v)
{
    ImVec2 p = ImGui::GetCursorScreenPos();
    ImDrawList* draw_list = ImGui::GetWindowDrawList();

    float height = 24.0f;
    float width = 48.0f;
    float radius = height * 0.50f;
    ImGuiID id = ImGui::GetID(label);

    ImGui::InvisibleButton(label, ImVec2(width, height));
    if (ImGui::IsItemClicked())
        *v = !*v;
    float lastAnimPos = ImGui::GetStateStorage()->GetFloat(id, *v ? 1.0f : 0.0f);
    float animPos = ImLerp(lastAnimPos, *v ? 1.0f : 0.0f, ImGui::GetIO().DeltaTime * 12.0f);
    ImGui::GetStateStorage()->SetFloat(id, animPos);

    bool hovered = ImGui::IsItemHovered();

    ImVec4 col_off = ImVec4(0.80f, 0.80f, 0.80f, 1.0f); // #CCCCCC
    ImVec4 col_on  = ImVec4(1.00f, 0.843f, 0.00f, 1.0f); // #FFD700

    if (hovered) {
        col_off.x += 0.05f; col_off.y += 0.05f; col_off.z += 0.05f;
    }

    ImU32 bg_col = ImGui::GetColorU32(ImLerp(col_off, col_on, animPos));
    ImU32 circle_col = IM_COL32(255, 255, 255, 255);
    draw_list->AddRectFilled(p, ImVec2(p.x + width, p.y + height), bg_col, radius);
    draw_list->AddRect(p, ImVec2(p.x + width, p.y + height),
                       IM_COL32(255, 215, 0, 255), radius, 0, 1.5f);
    float knob_radius = radius - 3.0f;
    float start_x = p.x + radius;
    float end_x = p.x + width - radius;
    float knob_x = ImLerp(start_x, end_x, animPos);
    draw_list->AddCircleFilled(ImVec2(knob_x, p.y + radius), knob_radius + 1.0f,
                               IM_COL32(0, 0, 0, 50));
    draw_list->AddCircleFilled(ImVec2(knob_x, p.y + radius), knob_radius, circle_col);
    // Red cheek
    draw_list->AddCircleFilled(ImVec2(knob_x + 3.0f, p.y + radius + 1.0f), 2.5f,
                               IM_COL32(255, 0, 0, 230), 12);

    ImGui::SameLine();
    ImGui::SetCursorPosY(ImGui::GetCursorPosY() + (height / 4));
    ImGui::Text("%s", label);
}

