    return reinterpret_cast<void*>(il2cpp_base + offset);
};

namespace Settings {
    static int Tab = 1;
}

bool clearMousePos = true;
bool initImGui = false;

// ============================================================
//  HOOK: eglSwapBuffers (MAIN UI)
// ============================================================
inline EGLBoolean (*old_eglSwapBuffers)(EGLDisplay dpy, EGLSurface surface);
inline EGLBoolean hook_eglSwapBuffers(EGLDisplay dpy, EGLSurface surface) {
    eglQuerySurface(dpy, surface, EGL_WIDTH, &g_GlWidth);
    eglQuerySurface(dpy, surface, EGL_HEIGHT, &g_GlHeight);

    if (!g_IsSetup) {
        prevWidth = g_GlWidth;
        prevHeight = g_GlHeight;
        SetupImgui();
        g_IsSetup = true;
    }

    static bool isTouching = false;
    static float touchStartTime = 0.0f;

    // Apply Pokémon theme every frame
    PokemonTheme();

    ImGuiIO& io = ImGui::GetIO();
    ImGui_ImplOpenGL3_NewFrame();
    ImGui_ImplAndroid_NewFrame(g_GlWidth, g_GlHeight);
    ImGui::NewFrame();

    // ---- Touch input ----
    int touchCount = ((int (*)())(Class_Input__get_touchCount))();
    if (touchCount > 0) {
        UnityEngine_Touch_Fields touch = ((UnityEngine_Touch_Fields(*)(int))(Class_Input__GetTouch))(0);
        float reverseY = io.DisplaySize.y - touch.m_Position.fields.y;
        io.MousePos = ImVec2(touch.m_Position.fields.x, reverseY);
        if (!isTouching) touchStartTime = ImGui::GetTime();
        io.MouseDown[0] = true;
        isTouching = true;
    } else {
        if (isTouching && (ImGui::GetTime() - touchStartTime < 0.06f)) {
            io.MouseDown[0] = true;
        } else {
            UpdateSpeedhack();
            io.MouseDown[0] = false;
            isTouching = false;
        }
    }

    // ---- ESP ----
    DrawESP(g_GlWidth, g_GlHeight);

    // ---- Background: pokeball watermark + lightning bolts ----
    DrawPokeballWatermark();
    DrawLightningBolts();

    // ---- Speed Hack floating mini window ----
    {
        ImVec2 screenCenter = ImGui::GetMainViewport()->GetCenter();
        ImVec2 screenSize   = ImGui::GetMainViewport()->Size;
        ImVec2 pos(screenCenter.x, screenCenter.y + screenSize.y * 0.30f);
        ImGui::SetNextWindowPos(pos, ImGuiCond_FirstUseEver, ImVec2(0.5f, 0.5f));
        ImGui::SetNextWindowBgAlpha(0.0f);
        if (ImGui::Begin("Speed Hack", nullptr,
            ImGuiWindowFlags_NoTitleBar |
            ImGuiWindowFlags_AlwaysAutoResize |
            ImGuiWindowFlags_NoResize |
            ImGuiWindowFlags_NoCollapse |
            ImGuiWindowFlags_NoScrollbar |
            ImGuiWindowFlags_NoSavedSettings))
        {
            PikachuToggle("SPEED TIMER", &SpeedHack);
        }
        ImGui::End();
    }

    // ---- Main Pokémon menu ----
    ImGui::SetNextWindowSize(ImVec2((float)g_GlWidth * 0.62f,
                                    (float)g_GlHeight * 0.72f),
                             ImGuiCond_Once);
    if (ImGui::Begin("PAPAJI EVIEL", nullptr,
        ImGuiWindowFlags_NoBringToFrontOnFocus |
        ImGuiWindowFlags_NoCollapse))
		
		ImDrawList* pDrawList;
const auto& pWindowDrawList = ImGui::GetWindowDrawList();
//pDrawList = pWindowDrawList;
                    
static const int numParticles = 250;
static ImVec2 particlePositions[numParticles];
static ImVec2 particleDistance;
static ImVec2 particleVelocities[numParticles];

static bool initialized = false;
if (!initialized)
{
for (int i = 0; i < numParticles; ++i)
{
particlePositions[i] = ImVec2(
ImGui::GetWindowPos().x + ImGui::GetWindowSize().x * static_cast<float>(rand()) / RAND_MAX,
ImGui::GetWindowPos().y + ImGui::GetWindowSize().y * static_cast<float>(rand()) / RAND_MAX
);

particleVelocities[i] = ImVec2(
static_cast<float>((rand() % 150) - 70),
static_cast<float>((rand() % 150) - 70)
);

}

initialized = true;
}

ImVec2 cursorPos = ImGui::GetIO().MousePos;
for (int i = 0; i < numParticles; ++i)
{
  //draw lines to particles
for (int j = i + 1; j < numParticles; ++j)
{
float distance = std::hypotf(particlePositions[j].x - particlePositions[i].x, particlePositions[j].y - particlePositions[i].y);
float opacity = 1.0f - (distance / 60.0f);  // opacity cahnge

if (opacity > 0.0f)
{
ImU32 lineColor = ImGui::GetColorU32(ImVec4(1.0f, 1.f, 1.0f, opacity));
//pDrawList->AddLine(particlePositions[i], particlePositions[j], lineColor);
}
}
  
  //draw lines to cursor
float distanceToCursor = std::hypotf(cursorPos.x - particlePositions[i].x, cursorPos.y - particlePositions[i].y);
float opacityToCursor = 1.0f - (distanceToCursor / 60.0f);  // Adjust the divisor to control the opacity change

  if (opacityToCursor > 0.0f)
  {
   ImU32 lineColorToCursor = ImGui::GetColorU32(ImVec4(0.5f, 0.8f, 1.0f, opacityToCursor));
   //pDrawList->AddLine(cursorPos, particlePositions[i], lineColorToCursor);
  }
 }
      
 //update and render particles
 float deltaTime = ImGui::GetIO().DeltaTime;
 for (int i = 0; i < numParticles; ++i)
 {
  particlePositions[i].x += particleVelocities[i].x * deltaTime;
  particlePositions[i].y += particleVelocities[i].y * deltaTime;

  // Stay in window
  if (particlePositions[i].x < ImGui::GetWindowPos().x)
   particlePositions[i].x = ImGui::GetWindowPos().x + ImGui::GetWindowSize().x;
  else if (particlePositions[i].x > ImGui::GetWindowPos().x + ImGui::GetWindowSize().x)
   particlePositions[i].x = ImGui::GetWindowPos().x;

  if (particlePositions[i].y < ImGui::GetWindowPos().y)
   particlePositions[i].y = ImGui::GetWindowPos().y + ImGui::GetWindowSize().y;
  else if (particlePositions[i].y > ImGui::GetWindowPos().y + ImGui::GetWindowSize().y)
   particlePositions[i].y = ImGui::GetWindowPos().y;

  ImU32 particleColour = ImColor(0, 0, 255, 255);

  //render particles behind components
 // pDrawList->AddCircleFilled(particlePositions[i], 5.0f, particleColour);
 }
    {
        static int activeTab = 0;

        // Tabs — pokeball style
        if (PokeballTab("AIM",   activeTab == 0)) activeTab = 0;
        ImGui::SameLine();
        if (PokeballTab("ESP",   activeTab == 1)) activeTab = 1;
        ImGui::SameLine();
        if (PokeballTab("CATCH", activeTab == 2)) activeTab = 2;
        ImGui::SameLine();
        if (PokeballTab("MISC",  activeTab == 3)) activeTab = 3;

        ImGui::Spacing();
        ImGui::Separator();
        ImGui::Spacing();

        // ===== AIM =====
        if (activeTab == 0) {
            ModRow("Enable AimBot", &Aimbot);
            ImGui::Combo("##AimDir", &AimWhen, dir, IM_ARRAYSIZE(dir));
            ImGui::SliderFloat("FOV",      &Fov_Aim, 0.0f, 500.0f,  "%.f");
            ImGui::SliderFloat("Distance", &Aimdis,  0.0f, 1000.0f, "%.f");
        }
        // ===== ESP =====
        else if (activeTab == 1) {
            ModRow("Enable ESP", &Enable);
            ModRow("ESP LINE",     &Config.ESP.Line);
            ImGui::SameLine();
            ImGui::ColorEdit4("##LineColor", (float*)&colorLine,
                              ImGuiColorEditFlags_NoInputs);
            ModRow("ESP BOX",      &Config.ESP.Box);
            ImGui::SameLine();
            ImGui::ColorEdit4("##BoxColor",  (float*)&colorBox,
                              ImGuiColorEditFlags_NoInputs);
            ModRow("ESP NAME",     &Config.ESP.Distancia);
            ModRow("ESP DISTANCE", &Config.ESP.Jarak);
            ModRow("ESP HEALTH",   &Config.ESP.Health);
        }
        // ===== CATCH =====
        else if (activeTab == 2) {
            ModRow("Sniper Fast", &SniperFast);
            ModRow("Reset Acc",   &Reset);
        }
        // ===== MISC =====
        else {
            ModRow("Speedhack", &SpeedHack);
            ImGui::Spacing();
            ImGui::TextColored(ImVec4(0.6f, 0.1f, 0.1f, 1.0f), "</> Dev: CrossMods");
            ImGui::TextColored(ImVec4(0.6f, 0.1f, 0.1f, 1.0f), "TELEGRAM: @CROSSMODS");
        }

        ImGui::Spacing();
        ImGui::Separator();
        ImGui::Spacing();

        // Close button centered
        float ww = ImGui::GetWindowWidth();
        ImGui::SetCursorPosX((ww - 140.0f) * 0.5f);
        if (PokeballCloseButton("CLOSE")) {
            // Apna close logic yahan — e.g. ShowMenu = false;
        }
    }
    ImGui::End();

    ImGui::Render();
    ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
    return old_eglSwapBuffers(dpy, surface);
}

// ============================================================
//  STARTUP
// ============================================================
typedef unsigned long DWORD;
static uintptr_t libBase;

inline void StartGUI() {
    void *ptr_eglSwapBuffer = DobbySymbolResolver("/system/lib/libEGL.so", "eglSwapBuffers");
    if (ptr_eglSwapBuffer != nullptr) {
        DobbyHook((void *)ptr_eglSwapBuffer, (void *)hook_eglSwapBuffers,
                  (void **)&old_eglSwapBuffers);
        LOGD("GUI started successfully");
    }
}

void hack_thread() {
    sleep(5);
    pid_t pid = getpid();
    LOGD("Hack Thread initiated for PID: %i", pid);

    do {
        il2cpp_base = get_module_base(pid, "libil2cpp.so");
        sleep(1);
    } while (il2cpp_base == 0);

    LOGD("libil2cpp.so found at address: 0x%" PRIxPTR, il2cpp_base);
    Il2CppAttach();

    DobbyHook(Il2CppGetMethodOffset(OBFUSCATE("Assembly-CSharp.dll"),
                                    OBFUSCATE("COW"),
                                    OBFUSCATE("GameConfig"),
                                    OBFUSCATE("get_ResetGuest"), 0),
              (void *) ResetGuest, (void **) &_ResetGuest);

    DobbyHook(Il2CppGetMethodOffset(OBFUSCATE("Assembly-CSharp.dll"),
                                    OBFUSCATE("COW.GamePlay"),
                                    OBFUSCATE("Weapon"),
                                    OBFUSCATE("IsContinuousGen"), 0),
              (void *) IsContinuousGen, (void **) &_IsContinuousGen);

    StartGUI();
}

